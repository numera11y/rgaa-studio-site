---
import { ArrowRight } from '@lucide/astro';

const base = import.meta.env.BASE_URL;
const basePath = base.endsWith('/') ? base : `${base}/`;

const steps = [
  {
    id: 'page',
    title: 'Observer une page',
    description: 'Le site reste visible pendant que l’auditeur parcourt les pages retenues dans son dossier.',
    image: '06-espace-audit-site.webp',
    alt: 'Accueil de numera11y affiché dans le navigateur intégré de RGAA Studio, avec la liste des pages et le panneau Inspection.',
    action: 'Voir la page dans l’audit',
  },
  {
    id: 'structure',
    title: 'Explorer les repères',
    description: 'Consulter le DOM, la structure HTML5, les rôles ARIA ou le résumé technique de la page.',
    image: '11-html5-semantique.webp',
    alt: 'Page numera11y à côté de l’exploration de sa structure HTML5 dans RGAA Studio.',
    action: 'Explorer la structure',
  },
  {
    id: 'suggestions',
    title: 'Examiner les suggestions',
    description: 'Les résultats automatisés aident à repérer des pistes ; ils ne sont ni exhaustifs ni un verdict.',
    image: '15-resultats-axe-core.webp',
    alt: 'Suggestions axe-core de la page numera11y, chacune proposée à l’examen de l’auditeur.',
    action: 'Voir les pistes automatiques',
  },
  {
    id: 'decision',
    title: 'Mesurer puis interpréter',
    description: 'La pipette relève des couleurs ; l’auditeur interprète la mesure et consigne lui-même son résultat dans le dossier.',
    image: '22-pipette-contraste.webp',
    alt: 'Mesure de contraste dans le panneau Inspection ; la note précise qu’il s’agit d’un indice, pas d’une décision de conformité.',
    action: 'Mesurer un contraste',
  },
  {
    id: 'synthese',
    title: 'Reprendre le fil du dossier',
    description: 'La vue d’ensemble distingue la progression des pages, les suggestions à examiner, les décisions humaines et les preuves enregistrées.',
    image: '07-tableau-de-bord.webp',
    alt: 'Vue d’ensemble d’un dossier RGAA Studio avec son avancement et ses indicateurs.',
    action: 'Voir la synthèse du dossier',
  },
];
---

<section class="journey-section section-space" id="parcours" aria-labelledby="journey-title">
  <div class="page-width">
    <div class="section-heading journey-heading">
      <div>
        <h2 id="journey-title">Un fil pour garder le cap.</h2>
        <p>Du site observé aux éléments consignés, l’audit se construit page après page.</p>
      </div>
      <p class="heading-note">Un dossier, un site, un référentiel.</p>
    </div>

    <ol class="journey-route" aria-label="Parcours dans RGAA Studio">
      {steps.map((step, index) => {
        return (
          <li class:list={{ 'route-stop': true, 'route-stop-first': index === 0 }}>
            <a href={`#etape-${step.id}`}>
              <span class="route-step-number">{String(index + 1).padStart(2, '0')}</span>
              <span class="route-step-title">{step.title}</span>
            </a>
          </li>
        );
      })}
    </ol>

    <div class="journey-story" data-journey-story>
      <figure class="journey-sticky">
        <img
          data-journey-image
          src={`${basePath}media/${steps[0].image}`}
          alt={steps[0].alt}
          width="1600"
          height="860"
        />
        <figcaption data-journey-caption>{steps[0].title} · {steps[0].action}</figcaption>
        <p class="visually-hidden" data-journey-announcer aria-live="polite"></p>
      </figure>

      <div class="journey-narrative">
        {steps.map((step, index) => (
          <article
            class="journey-copy-step"
            id={`etape-${step.id}`}
            data-journey-step
            data-index={index}
            data-title={step.title}
            data-action={step.action}
            data-image={`${basePath}media/${step.image}`}
            data-alt={step.alt}
          >
            <h3>{step.title}</h3>
            <p>{step.description}</p>
            {index === steps.length - 1 && (
              <a class="text-link" href={`${basePath}telechargements/`}>
                Découvrir l’application <ArrowRight size={16} aria-hidden="true" />
              </a>
            )}
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const story = document.querySelector<HTMLElement>('[data-journey-story]');
  const image = story?.querySelector<HTMLImageElement>('[data-journey-image]');
  const caption = story?.querySelector<HTMLElement>('[data-journey-caption]');
  const announcer = story?.querySelector<HTMLElement>('[data-journey-announcer]');
  const steps = [...(story?.querySelectorAll<HTMLElement>('[data-journey-step]') ?? [])];
  const routeLinks = [...(document.querySelectorAll<HTMLAnchorElement>('.journey-route a[href^="#etape-"]'))];
  let activeId: string | undefined;
  let swapToken = 0;

  function activateStep(step: HTMLElement, announce = false) {
    if (!image || !caption || activeId === step.id) return;
    activeId = step.id;
    steps.forEach((item) => item.classList.toggle('is-active', item === step));
    routeLinks.forEach((link) => {
      if (link.hash === `#${step.id}`) link.setAttribute('aria-current', 'step');
      else link.removeAttribute('aria-current');
    });
    const imagePath = step.dataset.image ?? image.src;
    const nextImage = new Image();
    const currentSwap = ++swapToken;
    image.classList.add('is-changing');
    const finishSwap = () => {
      if (currentSwap !== swapToken) return;
      image.src = imagePath;
      image.alt = step.dataset.alt ?? '';
      caption.textContent = `${step.dataset.title} · ${step.dataset.action}`;
      image.classList.remove('is-changing', 'is-swapping');
      void image.offsetWidth;
      image.classList.add('is-swapping');
      window.setTimeout(() => image.classList.remove('is-swapping'), 450);
    };
    nextImage.onload = finishSwap;
    nextImage.onerror = () => {
      if (currentSwap === swapToken) image.classList.remove('is-changing');
    };
    nextImage.src = imagePath;
    if (announce && announcer) announcer.textContent = `${step.dataset.title}. ${step.dataset.action}.`;
  }

  const firstStep = steps[0];
  if (firstStep) {
    activeId = firstStep.id;
    firstStep.classList.add('is-active');
    routeLinks.find((link) => link.hash === `#${firstStep.id}`)?.setAttribute('aria-current', 'step');
  }

  if (steps.length > 0 && image && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      const visible = entries.filter((entry) => entry.isIntersecting)
        .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
      if (visible) activateStep(visible.target as HTMLElement);
    }, { rootMargin: '-36% 0px -38% 0px', threshold: [0, 0.2, 0.45, 0.7] });
    steps.forEach((step) => observer.observe(step));
    routeLinks.forEach((link) => {
      link.addEventListener('click', () => {
        const target = steps.find((step) => `#${step.id}` === link.hash);
        if (target) activateStep(target, true);
      });
    });
  }
</script>
