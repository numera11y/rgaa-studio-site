---
import {
  BookOpen,
  CircleCheck,
  Contrast,
  FileSearch,
  Globe,
  ScanSearch,
} from '@lucide/astro';

const base = import.meta.env.BASE_URL;
const basePath = base.endsWith('/') ? base : `${base}/`;

const steps = [
  {
    id: 'page',
    title: 'Observer une page',
    description: 'Le site reste visible pendant que l’auditeur parcourt les pages retenues dans son dossier.',
    image: '06-espace-audit-site.webp',
    alt: 'Accueil de numera11y affiché dans le navigateur intégré de RGAA Studio, avec la liste des pages et le panneau Inspection.',
    icon: Globe,
    action: 'Voir la page dans l’audit',
  },
  {
    id: 'structure',
    title: 'Explorer les repères',
    description: 'Consulter le DOM, la structure HTML5, les rôles ARIA ou le résumé technique de la page.',
    image: '11-html5-semantique.webp',
    alt: 'Page numera11y à côté de l’exploration de sa structure HTML5 dans RGAA Studio.',
    icon: BookOpen,
    action: 'Explorer la structure',
  },
  {
    id: 'suggestions',
    title: 'Examiner les suggestions',
    description: 'Les résultats automatisés aident à repérer des pistes ; ils ne sont ni exhaustifs ni un verdict.',
    image: '15-resultats-axe-core.webp',
    alt: 'Suggestions axe-core de la page numera11y, chacune proposée à l’examen de l’auditeur.',
    icon: ScanSearch,
    action: 'Voir les pistes automatiques',
  },
  {
    id: 'decision',
    title: 'Mesurer puis interpréter',
    description: 'La pipette relève des couleurs ; l’auditeur interprète la mesure et consigne lui-même son résultat dans le dossier.',
    image: '22-pipette-contraste.webp',
    alt: 'Mesure de contraste dans le panneau Inspection ; la note précise qu’il s’agit d’un indice, pas d’une décision de conformité.',
    icon: Contrast,
    action: 'Mesurer un contraste',
  },
  {
    id: 'synthese',
    title: 'Reprendre le fil du dossier',
    description: 'La vue d’ensemble distingue la progression des pages, les suggestions à examiner, les décisions humaines et les preuves enregistrées.',
    image: '07-tableau-de-bord.webp',
    alt: 'Vue d’ensemble d’un dossier RGAA Studio avec son avancement et ses indicateurs.',
    icon: CircleCheck,
    action: 'Voir la synthèse du dossier',
  },
];
---

<section class="journey-section section-space" id="parcours" aria-labelledby="journey-title">
  <div class="page-width">
    <div class="section-heading journey-heading">
      <div>
        <h2 id="journey-title">Un fil pour garder le cap.</h2>
        <p>Du site observé aux éléments consignés, l’audit se construit page après page.</p>
      </div>
      <p class="heading-note"><FileSearch size={18} stroke-width={1.8} aria-hidden="true" /> Un dossier, un site, un référentiel.</p>
    </div>

    <ol class="journey-route" aria-label="Parcours dans RGAA Studio">
      {steps.map((step, index) => {
        const Icon = step.icon;
        return (
          <li class:list={{ 'route-stop': true, 'route-stop-first': index === 0 }}>
            <a href={`#etape-${step.id}`}>
              <span class="route-node"><Icon size={19} stroke-width={1.8} aria-hidden="true" /></span>
              <span>{step.title}</span>
            </a>
          </li>
        );
      })}
    </ol>

    <div class="journey-details">
      {steps.map((step, index) => {
        const Icon = step.icon;
        return (
          <details class="journey-step" id={`etape-${step.id}`} name="audit-journey" open={index === 0}>
            <summary>
              <span class="journey-step-icon"><Icon size={21} stroke-width={1.8} aria-hidden="true" /></span>
              <span class="journey-step-title">{step.title}</span>
              <span class="journey-step-action">{step.action}</span>
              <span class="journey-toggle" aria-hidden="true"></span>
            </summary>
            <div class="journey-panel">
              <figure class="journey-image">
                <img
                  src={`${basePath}media/${step.image}`}
                  alt={step.alt}
                  loading={index === 0 ? 'eager' : 'lazy'}
                  width="1600"
                  height="860"
                />
                <figcaption>Capture de l’application sur le site public numera11y.fr.</figcaption>
              </figure>
              <div class="journey-copy">
                <p class="journey-copy-label">{step.action}</p>
                <h3>{step.title}</h3>
                <p>{step.description}</p>
                <a class="text-link" href={`${basePath}#fonctionnalites`}>Voir les repères de l’espace d’audit</a>
              </div>
            </div>
          </details>
        );
      })}
    </div>
  </div>
</section>
