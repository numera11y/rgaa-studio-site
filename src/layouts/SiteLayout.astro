---
import '../styles/global.css';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'RGAA Studio — L’audit se construit, page après page',
  description = 'Le site, les pages et les repères d’accessibilité réunis dans un même espace de travail. Découvrez RGAA Studio.',
} = Astro.props;
const base = import.meta.env.BASE_URL;
const basePath = base.endsWith('/') ? base : `${base}/`;
const canonical = new URL(basePath, Astro.site);
const socialImage = new URL(`${basePath}media/01-espace-audit.webp`, Astro.site);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#eef2fa" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${basePath}media/rgaa-studio-icon.svg`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu principal</a>
    <SiteHeader />
    <main id="contenu"><slot /></main>
    <SiteFooter />
  </body>
</html>
